rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read all documents
    match /{document=**} {
      allow read: if request.auth != null;
    }
    
    // Allow access to Posts collection
    match /Posts/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow access to Users collection
    match /Users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow access to chatRooms and all subcollections
    match /chatRooms/{chatRoomId} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Allow authenticated users to create and read comments
    match /Comments/{commentId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow admins to write to Agenda collection
    match /Agenda/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Allow authenticated users to write to Notifications collection
    match /Notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
  }
} 